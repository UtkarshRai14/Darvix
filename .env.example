# Free API key: https://console.groq.com/keys (free tier is enough for this project)
GROQ_API_KEY=

# Optional overrides (defaults shown). All are available on Groq's free tier.
AGENT_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b
ASR_MODEL=whisper-large-v3-turbo

# Local embedding model (runs on CPU via fastembed/ONNX, downloaded once, no key needed)
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
